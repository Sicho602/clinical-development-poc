# Optional. NCBI recommends an API key for higher request limits.
NCBI_API_KEY=
NCBI_TOOL=clinical-development-explorer
NCBI_EMAIL=

CLINICAL_TRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
# Optional identifying User-Agent for ClinicalTrials.gov. Leave empty to use the app default.
CLINICAL_TRIALS_USER_AGENT=
PUBMED_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# Optional OpenAI-compatible Chat Completions endpoint. If omitted, the UI
# reports "Not Connected" and never generates evidence values.
EVIDENCE_EXTRACTION_PROVIDER=openai-compatible
EVIDENCE_EXTRACTION_API_URL=
EVIDENCE_EXTRACTION_API_KEY=
# Optional only when the provider requires a model in the request.
EVIDENCE_EXTRACTION_MODEL=

# Local repository location. Never commit the generated contents.
LOCAL_DATA_PATH=.data
